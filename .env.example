# ── App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=DealDesk
# (NODE_ENV is set by Next: dev → development, build/start → production. Don't set here.)

# ── Database (Supabase Postgres, London / eu-west-2)
#
# Drizzle uses DATABASE_URL for queries. The Supabase JS client keys below are
# kept for storage, realtime, and RLS testing helpers later in v1 (per the
# v1 plan, storage bolts on in v1.2 when pack PDFs ship). v1 dev does not
# need the JS client wired yet — placeholders are fine until then.
DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://[ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding/plan

# ── Stripe (test mode in dev — wired week 2)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_ELITE_MONTHLY=

# ── Inngest (week 3+)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── Resend (week 12 polish)
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@dealdesk.com

# ── Sentry (week 11)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ── PostHog (EU cloud)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
